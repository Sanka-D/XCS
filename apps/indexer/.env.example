# Contract for the XCS indexer worker.
# Names only; values live in the deployment's secret store.
#
# This file holds secrets and values that genuinely differ per deployment.
# Behavioural settings -- the poll interval, the lease duration and the batch
# size -- are checked-in code, in src/settings.ts; they are not deployment
# inputs and a variable of the same name here has no effect.

# PostgreSQL connection string for the indexer role.
XCS_INDEXER_DATABASE_URL=                  # config
# Commons-operated complete-history rippled endpoint, supplied out of band.
XCS_RPC_URL_PRIMARY=                       # held
# Public fallback endpoint; no availability or retention SLA for XCS.
XCS_RPC_URL_SECONDARY=                     # held

# Path to the network profile JSON this worker indexes; must be the same
# published file the web app serves. Every profile is its own operator-created
# file (config/networks/README.md), so this one cannot live in code.
XCS_NETWORK_PROFILE=                       # config

# The three values below default in src/settings.ts to the safe public posture
# (`blackholed`, `shared`, and no acknowledgement). They stay overridable because
# ADR 0003's disposable controlled Testnet pilot is the one deployment that needs
# the weaker registry posture, and it must still supply every acknowledgement
# explicitly. Never set them for a public profile.
# `blackholed` or `controlled-testnet-pilot` (ADR 0003 only).
XCS_REGISTRY_POLICY=                       # optional config
# Must equal DISPOSABLE_PROFILE_AND_DATABASE for controlled-testnet-pilot.
XCS_CONTROLLED_PILOT_ACK=                  # optional config
# `shared` or `exclusive-profile`; the controlled pilot requires exclusive-profile.
XCS_DATABASE_SCOPE=                        # optional config

# The two values below are read only by db:bootstrap, run once from an operator
# machine or a one-off job against the external database. The long-running
# service reads only the variables above.
#
# db:bootstrap is grants-only. The managed database service owns the users: create
# xcs_indexer, xcs_api and xcs_monitor in the DigitalOcean control panel or with
# `doctl databases user create`, take the passwords DigitalOcean generates, and
# only then run db:bootstrap as the administrator. It never creates a role and
# never sets, resets or reads a role password; a missing role fails the run by
# name. No runtime password is an input here.
XCS_BOOTSTRAP_DATABASE_URL=                # optional held
# Must be exactly `dedicated`: an acknowledgement, not a choice. The grants and
# role attributes db:bootstrap applies are cluster-visible, so it refuses to run
# on a cluster the operator does not own.
XCS_DATABASE_CLUSTER_SCOPE=                # optional config
