{
  "name": "@xcs-protocol/api",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/main.ts --format esm --dts --clean",
    "clean": "rm -rf dist coverage",
    "dev": "tsx watch src/main.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@xcs-protocol/core": "workspace:*",
    "@xcs-protocol/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.5.0",
    "ipaddr.js": "^2.2.0",
    "undici": "^7.13.0",
    "xrpl": "^5.0.0"
  }
}
