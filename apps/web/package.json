{
  "name": "@xcs-protocol/web",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "XCS_BROWSER_E2E=0 XCS_LOCAL_PAYLOAD_STORE=0 nuxt build",
    "clean": "rm -rf .nuxt .output coverage",
    "dev": "nuxt dev",
    "lint": "NODE_ENV=development XCS_BROWSER_E2E=0 XCS_LOCAL_PAYLOAD_STORE=0 nuxt prepare && eslint . && NODE_ENV=development XCS_BROWSER_E2E=0 XCS_LOCAL_PAYLOAD_STORE=0 nuxt typecheck",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:postgres": "XCS_REQUIRE_POSTGRES_TESTS=1 vitest run --no-file-parallelism test/api/suites/postgres.integration.test.ts test/auth-postgres.integration.test.ts",
    "test:runtime": "XCS_REQUIRE_RUNTIME_TESTS=1 vitest run test/api/runtime.integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:security": "playwright test --config playwright.security.config.ts",
    "typecheck": "NODE_ENV=development XCS_BROWSER_E2E=0 XCS_LOCAL_PAYLOAD_STORE=0 nuxt typecheck",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.135",
    "@iconify-json/simple-icons": "^1.2.97",
    "@nuxt/ui": "^4.11.1",
    "@nuxtjs/i18n": "^10.0.6",
    "@xcs-protocol/core": "workspace:*",
    "@xcs-protocol/db": "workspace:*",
    "@xcs-protocol/sdk": "workspace:*",
    "@xrpl-commons/xrpl-connect-vue": "1.0.0-rc.2",
    "ajv": "^8.17.1",
    "drizzle-orm": "^0.45.2",
    "fast-json-stringify": "^6.1.1",
    "h3": "1.15.11",
    "ipaddr.js": "^2.2.0",
    "nuxt": "^4.5.2",
    "nuxt-security": "2.6.0",
    "ofetch": "^1.5.1",
    "openid-client": "6.8.8",
    "rate-limiter-flexible": "^7.3.1",
    "ripple-keypairs": "3.0.0",
    "undici": "^7.13.0",
    "vue": "^3.5.21",
    "vue-router": "^5.2.0",
    "xrpl": "^5.0.0",
    "xrpl-connect": "1.0.0-rc.2"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "eslint-config-prettier": "^10.1.8",
    "light-my-request": "^6.6.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.2"
  }
}
