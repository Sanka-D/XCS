# Contract for the XCS web app (Nuxt server + the /v1 read API).
# Names only; values live in the deployment's secret store.
#
# This file holds secrets and values that genuinely differ per deployment.
# Behavioural settings and feature flags are checked-in code, in
# server/xcs/settings.ts; they are not deployment inputs and a variable of the
# same name here has no effect.

# Read-only PostgreSQL connection string for the API role.
XCS_DATABASE_URL=                          # config
# Comma-separated browser origins allowed on /v1/**; `*` is rejected.
XCS_ALLOWED_ORIGINS=                       # config
# Narrow reverse-proxy CIDRs trusted for forwarded client-IP headers; catch-all /0 is rejected.
XCS_TRUSTED_PROXY_CIDRS=                   # optional config
# Bearer token guarding /internal/metrics*; 32 to 256 URL-safe characters. Setting
# it is what turns the two routes on; left unset the routes are not registered at
# all. A value that is not 32 to 256 URL-safe characters fails at start-up rather
# than leaving the deployment quietly unmonitored.
XCS_METRICS_TOKEN=                         # optional generate
# Salt for hashing pinning client addresses; at least 32 random bytes. Read only
# once XCS_DEMO_PINNING_ENABLED is turned on in server/xcs/settings.ts.
XCS_PINNING_IP_HASH_SECRET=                # optional generate
# Path to the network profile JSON this deployment serves; the browser-visible
# profile identifier is that file's `profileId`. Must be the same published file
# the indexer indexes. Left unset, the site does not filter the network list,
# which is what an unset NUXT_PUBLIC_PROFILE_ID used to mean.
XCS_NETWORK_PROFILE=                       # optional config
# Public wss:// XRPL submission endpoint; no credentials, no private indexer URL.
NUXT_PUBLIC_RPC_URL=                       # config
# Public Xaman application identifier; enables the Xaman adapter.
NUXT_PUBLIC_XAMAN_API_KEY=                 # optional
# Deployment origin with a trailing slash, registered in the Xaman Developer Console.
NUXT_PUBLIC_XAMAN_REDIRECT_URL=            # optional config
# Public Reown project identifier; enables the WalletConnect adapter.
NUXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=     # optional
