{
  "version": "0.1",
  "cases": [
    {
      "id": "lifecycle-state.pending-without-expiration",
      "name": "projects an unaccepted live object as pending",
      "input": { "objectExists": true, "accepted": false, "expiration": null, "closeTime": 100 },
      "state": "pending"
    },
    {
      "id": "lifecycle-state.active-without-expiration",
      "name": "projects an accepted live object as active",
      "input": { "objectExists": true, "accepted": true, "expiration": null, "closeTime": 100 },
      "state": "active"
    },
    {
      "id": "lifecycle-state.pending-before-expiration",
      "name": "keeps an unaccepted object pending before expiration",
      "input": { "objectExists": true, "accepted": false, "expiration": 101, "closeTime": 100 },
      "state": "pending"
    },
    {
      "id": "lifecycle-state.active-before-expiration",
      "name": "keeps an accepted object active before expiration",
      "input": { "objectExists": true, "accepted": true, "expiration": 101, "closeTime": 100 },
      "state": "active"
    },
    {
      "id": "lifecycle-state.pending-expires-at-close-time",
      "name": "expiration at close time dominates pending",
      "input": { "objectExists": true, "accepted": false, "expiration": 100, "closeTime": 100 },
      "state": "expired"
    },
    {
      "id": "lifecycle-state.active-expires-at-close-time",
      "name": "expiration at close time dominates acceptance",
      "input": { "objectExists": true, "accepted": true, "expiration": 100, "closeTime": 100 },
      "state": "expired"
    },
    {
      "id": "lifecycle-state.expired-before-close-time",
      "name": "projects a past expiration as expired",
      "input": { "objectExists": true, "accepted": false, "expiration": 99, "closeTime": 100 },
      "state": "expired"
    },
    {
      "id": "lifecycle-state.deleted-dominates",
      "name": "deletion dominates acceptance and expiration",
      "input": { "objectExists": false, "accepted": true, "expiration": 0, "closeTime": 100 },
      "state": "deleted"
    },
    {
      "id": "lifecycle-state.uint32-maximum-boundary",
      "name": "expires exactly at the uint32 maximum close time",
      "input": {
        "objectExists": true,
        "accepted": true,
        "expiration": 4294967295,
        "closeTime": 4294967295
      },
      "state": "expired"
    }
  ]
}
