{
  "name": "@xcs-protocol/cli",
  "version": "0.1.0-alpha.1",
  "description": "JSON-first command line interface for XCS",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/XRPL-Commons/XCS/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XRPL-Commons/XCS.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/XRPL-Commons/XCS/issues"
  },
  "keywords": [
    "cli",
    "credentials",
    "xrpl"
  ],
  "bin": {
    "xcs": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "lint": "tsc --noEmit",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xcs-protocol/core": "workspace:*",
    "@xcs-protocol/sdk": "workspace:*",
    "commander": "^14.0.0",
    "xrpl": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
