{
  "name": "@xcs-protocol/core",
  "version": "0.1.0-alpha.1",
  "description": "Protocol domain model for XCS schemas and XRPL credentials",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/XRPL-Commons/XCS/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XRPL-Commons/XCS.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/XRPL-Commons/XCS/issues"
  },
  "keywords": [
    "credentials",
    "protocol",
    "xrpl"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "clean": "rm -rf dist coverage",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "@scure/base": "2.3.0",
    "canonicalize": "4.0.0",
    "jsonc-parser": "3.3.1",
    "multiformats": "14.0.5",
    "tr46": "4.1.1",
    "xrpl": "5.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
