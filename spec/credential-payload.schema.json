{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xcs.dev/schema/credential-payload-v0.1.json",
  "title": "XCS v0.1 Credential Payload Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["xcsVersion", "issuer", "subject", "schema", "claims"],
  "properties": {
    "xcsVersion": { "const": "0.1" },
    "issuer": { "type": "string", "pattern": "^r[1-9A-HJ-NP-Za-km-z]{24,34}$" },
    "subject": { "type": "string", "pattern": "^r[1-9A-HJ-NP-Za-km-z]{24,34}$" },
    "schema": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "claims": { "type": "object" }
  }
}
