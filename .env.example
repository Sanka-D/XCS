# The controlled pilot file is created from testnet.example.json only after its public
# registry address and activation boundary are known. It must contain profileId
# commons-testnet-xcs-v0.1-controlled-pilot and is never reused for the public beta.
XCS_NETWORK_PROFILE=./config/networks/commons-testnet-xcs-v0.1-controlled-pilot.json
XCS_BIND_ADDRESS=127.0.0.1
XCS_POSTGRES_ADMIN_PASSWORD=replace-with-a-long-url-safe-random-admin-password
XCS_INDEXER_DATABASE_PASSWORD=replace-with-a-long-url-safe-random-indexer-password
XCS_API_DATABASE_PASSWORD=replace-with-a-long-url-safe-random-api-password
# Shared only by the private Nuxt SSR-to-API hop. Required: generate 32+ URL-safe random characters.
XCS_INTERNAL_API_TOKEN=
# Optional internal operational snapshot. Use a distinct 32+ character token when enabled.
XCS_METRICS_ENABLED=false
XCS_METRICS_TOKEN=
# Admin/migrator access is bootstrap-only; runtime processes must not use it.
XCS_MIGRATOR_DATABASE_URL=postgres://xcs_admin:replace-with-a-long-url-safe-random-admin-password@localhost:5432/xcs
# Validation scan budget; raise for a large projection, or use 0 for no statement timeout.
XCS_MIGRATION_STATEMENT_TIMEOUT_MS=1800000
XCS_INDEXER_DATABASE_URL=postgres://xcs_indexer:replace-with-a-long-url-safe-random-indexer-password@localhost:5432/xcs
# The API uses XCS_DATABASE_URL for backward compatibility.
XCS_DATABASE_URL=postgres://xcs_api:replace-with-a-long-url-safe-random-api-password@localhost:5432/xcs
XCS_API_HOST=0.0.0.0
XCS_API_PORT=3001
XCS_PUBLIC_API_BASE_URL=http://localhost:3001
XCS_PUBLIC_PROFILE_ID=commons-testnet-xcs-v0.1-controlled-pilot
XCS_ALLOWED_ORIGINS=http://localhost:3000
# Optional. Set only to narrow reverse-proxy IP/CIDR values that overwrite forwarded client-IP headers.
# Catch-all /0 networks are rejected. Compose applies this trust list to both API and web SSR.
XCS_TRUSTED_PROXY_CIDRS=
XCS_READINESS_MAX_LEDGER_AGE_SECONDS=120
# The controlled pilot primary is a Commons-operated complete-history rippled endpoint supplied
# out of band. Leave it empty rather than committing a hostname, credential or deployable fake.
XCS_RPC_URL_PRIMARY=
# Public pilot fallback operated by Ripple. It has no availability or retention SLA for XCS.
XCS_RPC_URL_SECONDARY=wss://s.altnet.rippletest.net:51233
# Public, browser-reachable endpoint. Never put credentials or a private indexer URL here.
# This XRPL Labs public service has no availability SLA for XCS and is not verification authority.
XCS_PUBLIC_RPC_URL=wss://testnet.xrpl-labs.com/
# Safe default for every normal profile. The private controlled pilot requires both explicit
# values documented in ADR 0003; never enable them for a public beta profile.
XCS_REGISTRY_POLICY=blackholed
XCS_CONTROLLED_PILOT_ACK=
XCS_INDEXER_POLL_INTERVAL_MS=4000
XCS_INDEXER_BATCH_SIZE=20
XCS_INDEXER_LEASE_DURATION_MS=30000
# Required together for live replay; optional exact-boundary cross-check in fixture replay.
XCS_REPLAY_TARGET_LEDGER_INDEX=
XCS_REPLAY_TARGET_LEDGER_HASH=
# Optional offline replay: both values are required together and replace live RPC input.
XCS_REPLAY_FIXTURE_BUNDLE=
XCS_REPLAY_FIXTURE_BUNDLE_SHA256=
# Required only by `fixture:capture`; capture always starts at profile activation.
XCS_FIXTURE_TARGET_LEDGER_INDEX=
XCS_FIXTURE_OUTPUT=
XCS_FIXTURE_PRIMARY_OPERATOR=XRPL Commons
# Descriptive capture label only; it is not proof of availability, retention or independence.
XCS_FIXTURE_SECONDARY_OPERATOR=Ripple
# Required only by `fixture:validate`.
XCS_FIXTURE_BUNDLE=
# SHA-256 printed by fixture:capture for the exact canonical manifest.json bytes.
XCS_FIXTURE_BUNDLE_SHA256=
XCS_PAYLOAD_FETCH_ENABLED=false
XCS_IPFS_API_URL=http://localhost:5001
XCS_IPFS_GATEWAY_URL=https://ipfs.io/
XCS_DEMO_PINNING_ENABLED=false
XCS_PINNING_NETWORKS=
# Static pilot trust policy. Comma-separated XRPL classic addresses.
XCS_TRUSTED_ISSUERS=
XCS_UNTRUSTED_ISSUERS=
# Required only when XCS_DEMO_PINNING_ENABLED=true; use at least 32 random bytes.
XCS_PINNING_IP_HASH_SECRET=
