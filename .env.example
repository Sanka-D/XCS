# Nuxt site + API on DigitalOcean App Platform. Names only; values live in Passbolt.
# Managed PostgreSQL connections, private server-only secrets; never NUXT_PUBLIC_*.
# xcs_api: SELECT-only projection pool. Require TLS with the provider's CA.
NUXT_DATABASE_URL=                       # secret
# xcs_payload_writer: separate restricted pool; required only for publication/pinning.
NUXT_PAYLOAD_DATABASE_URL=               # optional secret
# Empty uses the site origin for browsers and local handlers for SSR.
NUXT_PUBLIC_API_BASE_URL=                # optional config
# Narrow ingress CIDRs only; ingress must replace client-supplied forwarding headers.
XCS_TRUSTED_PROXY_CIDRS=                 # optional config
XCS_ALLOWED_ORIGINS=                     # optional config
XCS_READINESS_MAX_LEDGER_AGE_SECONDS=120  # config
XCS_METRICS_ENABLED=false                # config
XCS_METRICS_TOKEN=                       # optional secret
# Opt-in Testnet hosting: configure these together with the writer connection.
XCS_HOSTED_PAYLOADS_ENABLED=false        # config
XCS_PUBLIC_PAYLOAD_BASE_URL=             # optional config
XCS_HOSTED_PAYLOAD_NETWORKS=             # optional config
XCS_PAYLOAD_STORAGE_IP_HASH_SECRET=      # optional secret
NUXT_PUBLIC_PAYLOAD_BASE_URL=            # optional config; matches hosting origin
NUXT_PUBLIC_PROFILE_ID=                  # config
NUXT_PUBLIC_RPC_URL=                     # public config, no provider credentials
NUXT_PUBLIC_XAMAN_API_KEY=               # optional public application identifier
NUXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=   # optional public application identifier

# Optional XRP Identity authentication. Disabled until registration and migration 0004 are ready.
XCS_AUTH_ENABLED=0                      # config
XCS_AUTH_ORIGIN=                        # exact HTTPS site origin
XCS_IDENTITY_ISSUER=https://account.xrpl.in
XCS_IDENTITY_CLIENT_ID=                 # private runtime secret; _FILE supported
XCS_IDENTITY_CLIENT_SECRET=             # private runtime secret; _FILE supported
NUXT_APP_DATABASE_URL=                  # xcs_app private pool; _FILE supported
XCS_AUTH_IDLE_SECONDS=1800
XCS_AUTH_MAX_SECONDS=28800
# Administrative bootstrap only, never the projection/indexer processes.
XCS_APP_DATABASE_PASSWORD=              # optional private bootstrap secret; _FILE supported

# Optional local administration (#30), after authentication and migration 0005.
XCS_ADMIN_ENABLED=0                     # requires XCS_AUTH_ENABLED=1
NUXT_ADMIN_DATABASE_URL=                # private xcs_admin_app pool; _FILE supported
XCS_ADMIN_DOCUMENT_KEY=                 # private random key, >=32 UTF-8 bytes; _FILE supported
XCS_ADMIN_DOCUMENT_DIRECTORY=           # absolute private directory, never public assets
XCS_NOTIFIER_DATABASE_URL=              # private xcs_notifier pool; _FILE supported
XCS_SMTP_HOST=127.0.0.1                 # local Mailpit only: 127.0.0.1, localhost, mailpit
XCS_SMTP_PORT=1025
XCS_MAILPIT_PORT=8025                   # Docker UI binds 127.0.0.1 only
# Optional bootstrap passwords. Required by docker-compose.admin.yml via _FILE.
XCS_ADMIN_DATABASE_PASSWORD=            # xcs_admin_app, not PostgreSQL xcs_admin; _FILE supported
XCS_NOTIFIER_DATABASE_PASSWORD=         # xcs_notifier; _FILE supported
# First-admin operator command only; exact existing OIDC issuer/subject, never email.
XCS_ADMIN_IDENTITY_ISSUER=
XCS_ADMIN_IDENTITY_SUBJECT=
XCS_ADMIN_BOOTSTRAP_OPERATOR=           # operator audit label, not a credential
# Synthetic local fixtures only: database name must begin xcs_admin_demo.
XCS_ADMIN_FIXTURE_DATABASE_URL=         # operator connection; never used by web or notifier
